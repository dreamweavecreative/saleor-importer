    draw = ImageDraw.Draw(img)
    
    # Try to load a nice font, fallback to default if unavailable
    try:
        font_large = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 36)
        font_medium = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 24)
        font_small = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/Sans.ttf", 18)
    except IOError:
        font_large = ImageFont.load_default()
        font_medium = ImageFont.load_default()
        font_small = ImageFont.load_default()

    # Draw top accent bar
    draw.rectangle([0, 0, width, 8], fill=(37, 99, 235)) # CAAG Blue
    
    # Brand Name
    brand_text = (brand or "UNKNOWN BRAND").upper()[:40]
    draw.text((40, 40), brand_text, fill=(37, 99, 235), font=font_large)
    
    # Category
    cat_text = (category or "Uncategorized").title()
